# ══════════════════════════════════════════════════════════════
# BundleBox SC1 — Production Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy to .env.prod and fill in values.
# DO NOT commit the filled .env.prod to git.
# ══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=<openssl rand -hex 32>

# ── Auth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dev.bundlebox.ai/auth/callback
JWT_SECRET=

# ── Storage ──────────────────────────────────────────────────
STORAGE_BACKEND=local

# ── Pipeline / ML ────────────────────────────────────────────
DETECTOR_TYPE=sam3
PIPELINE_SHARED_TOKEN=<openssl rand -hex 32>

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Gemini ───────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_COMPARISON_MODELS=gemini-2.5-flash-lite,gemini-2.5-pro
RESULTS_DIR=/home/bharat_bhaskar/results

# ── Web Push (VAPID) ────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ── Twilio (WhatsApp OTP) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["https://dev.bundlebox.ai","http://localhost:5173","http://localhost:3000"]
